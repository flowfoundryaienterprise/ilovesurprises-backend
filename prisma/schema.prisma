generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  AFFILIATE
  STAFF
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  STRIPE
  COD
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)

  cart         Cart?
  addresses    CustomerAddress[]
  orders       Order[]
  affiliateProfile AffiliateProfile?
  appraisals   AppraisalRecord[]
  reviews      ProductReview[]
  wishlistItems WishlistItem[]
  couponUsages CouponUsage[]
  notifications UserNotification[]
  membership   UserMembership?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)

  products    Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  bannerImage String?
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)

  products    ProductCollection[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("collections")
}

model Product {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  shortDescription  String?
  description       String?             @db.Text
  price             Decimal             @db.Decimal(10, 2)
  compareAtPrice    Decimal?            @db.Decimal(10, 2)
  imageUrl          String?
  categoryId        String?
  category          Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  surpriseType      String?             // CANDLE, BATH_BOMB, JEWELRY_ONLY
  surpriseValue     Decimal?            @db.Decimal(10, 2)
  rating            Float               @default(0)
  reviewCount       Int                 @default(0)
  stock             Int                 @default(0)
  lowStockThreshold Int                 @default(5)
  sku               String?             @unique
  badge             String?             // "Best Seller", "New Arrival", etc.
  isBestSeller      Boolean             @default(false)
  isNew             Boolean             @default(false)

  scentNotes        String[]            @default([])
  ringSizes         String[]            @default([])
  jewelryTypes      String[]            @default([])

  status            ProductStatus       @default(DRAFT)

  images            ProductImage[]
  options           ProductOption[]
  variants          ProductVariant[]
  collections       ProductCollection[]
  inventoryLogs     InventoryLog[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  reviews           ProductReview[]
  wishlistItems     WishlistItem[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@index([isBestSeller])
  @@index([isNew])
  @@map("products")
}

model ProductCollection {
  productId    String
  collectionId String
  sortOrder    Int        @default(0)

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@id([productId, collectionId])
  @@index([collectionId])
  @@index([productId])
  @@map("product_collections")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String               // "Ring Size", "Scent"

  values    ProductOptionValue[]

  createdAt DateTime             @default(now())

  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id        String        @id @default(cuid())
  optionId  String
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     String        // "Size 7", "Vanilla Rose"
  sortOrder Int           @default(0)

  createdAt DateTime      @default(now())

  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String?        // "Size 7 / Lavender"
  sku            String?        @unique
  price          Decimal        @db.Decimal(10, 2)
  compareAtPrice Decimal?       @db.Decimal(10, 2)
  stock          Int            @default(0)
  ringSize       String?
  scent          String?
  isActive       Boolean        @default(true)

  cartItems      CartItem[]
  inventoryLogs  InventoryLog[]
  orderItems     OrderItem[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model InventoryLog {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  changeQty   Int
  previousQty Int
  newQty      Int
  reason      String          // "INITIAL", "RESTOCK", "MANUAL_ADJUSTMENT", "CART_RESERVATION", "ORDER_FULFILLMENT"
  createdBy   String?

  createdAt   DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
  @@map("inventory_logs")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id               String          @id @default(cuid())
  cartId           String
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity         Int             @default(1)
  selectedRingSize String?
  selectedScent    String?
  customNote       String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

model CustomerAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("US")
  isDefault    Boolean  @default(false)

  orders       Order[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("customer_addresses")
}

model Order {
  id                      String               @id @default(cuid())
  orderNumber             String               @unique
  userId                  String
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                  OrderStatus          @default(PENDING)
  paymentStatus           PaymentStatus        @default(PENDING)
  paymentMethod           PaymentMethod
  currency                String               @default("USD")
  subtotal                Decimal              @db.Decimal(10, 2)
  shippingFee             Decimal              @default(0) @db.Decimal(10, 2)
  taxAmount               Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount          Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount             Decimal              @db.Decimal(10, 2)
  customerNote            String?
  shippingAddressId       String?
  shippingAddress         CustomerAddress?     @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingAddressSnapshot Json
  inventoryDeducted       Boolean              @default(false)

  items                   OrderItem[]
  fulfillments            OrderFulfillment[]
  notes                   OrderNote[]
  payments                PaymentTransaction[]
  refunds                 RefundRecord[]
  commissions             CommissionRecord[]
  couponUsages            CouponUsage[]

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName      String
  variantTitle     String?
  sku              String?
  unitPrice        Decimal         @db.Decimal(10, 2)
  quantity         Int
  lineTotal        Decimal         @db.Decimal(10, 2)
  selectedRingSize String?
  selectedScent    String?
  customNote       String?
  imageUrl         String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderFulfillment {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          FulfillmentStatus @default(UNFULFILLED)
  trackingCompany String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  notes           String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("order_fulfillments")
}

model OrderNote {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId          String?
  authorRole        String?
  note              String   @db.Text
  isCustomerVisible Boolean  @default(false)

  createdAt         DateTime @default(now())

  @@index([orderId])
  @@map("order_notes")
}

model PaymentTransaction {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod         PaymentMethod
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  stripeClientSecret    String?
  gatewayResponse       Json?
  errorMessage          String?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([stripePaymentIntentId])
  @@map("payment_transactions")
}

model RefundRecord {
  id                   String   @id @default(cuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentTransactionId String?
  amount               Decimal  @db.Decimal(10, 2)
  currency             String   @default("USD")
  reason               String?
  stripeRefundId       String?  @unique
  status               String   @default("COMPLETED")
  processedBy          String?

  createdAt            DateTime @default(now())

  @@index([orderId])
  @@map("refund_records")
}

// ==========================================
// PHASE 3 — AFFILIATE / MLM
// ==========================================

model AffiliateProfile {
  id                String                    @id @default(cuid())
  userId            String                    @unique
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode      String                    @unique
  slug              String?                   @unique
  sponsorId         String?
  sponsor           AffiliateProfile?         @relation("SponsorTree", fields: [sponsorId], references: [id], onDelete: SetNull)
  recruits          AffiliateProfile[]        @relation("SponsorTree")
  status            String                    @default("ACTIVE")
  lifetimeEarnings  Decimal                   @default(0) @db.Decimal(10, 2)
  currentBalance    Decimal                   @default(0) @db.Decimal(10, 2)
  pendingBalance    Decimal                   @default(0) @db.Decimal(10, 2)
  payoutMethod      String?
  payoutDetails     Json?
  commissionRate    Decimal                   @default(0.20) @db.Decimal(5, 4)

  genealogyNode     GenealogyNode?
  referralVisits    ReferralVisit[]
  commissions       CommissionRecord[]
  payoutRequests    PayoutRequest[]
  ledgerEntries     CommissionLedgerEntry[]

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([referralCode])
  @@index([sponsorId])
  @@index([status])
  @@map("affiliate_profiles")
}

model ReferralVisit {
  id           String            @id @default(cuid())
  affiliateId  String
  affiliate    AffiliateProfile  @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  landingPage  String?
  referrerUrl  String?
  converted    Boolean           @default(false)
  orderId      String?

  createdAt    DateTime          @default(now())

  @@index([affiliateId])
  @@index([createdAt])
  @@map("referral_visits")
}

model GenealogyNode {
  id           String            @id @default(cuid())
  affiliateId  String            @unique
  affiliate    AffiliateProfile  @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       GenealogyNode?    @relation("GenealogyHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     GenealogyNode[]   @relation("GenealogyHierarchy")
  level        Int               @default(0)
  path         String            @default("")

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([parentId])
  @@index([level])
  @@map("genealogy_nodes")
}

model CommissionRecord {
  id                String            @id @default(cuid())
  affiliateId       String
  affiliate         AffiliateProfile  @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  level             Int
  rate              Decimal           @db.Decimal(5, 4)
  orderAmount       Decimal           @db.Decimal(10, 2)
  commissionAmount  Decimal           @db.Decimal(10, 2)
  status            String            @default("PENDING")
  description       String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([affiliateId, orderId, level])
  @@index([affiliateId])
  @@index([orderId])
  @@index([status])
  @@map("commission_records")
}

model PayoutRequest {
  id              String            @id @default(cuid())
  affiliateId     String
  affiliate       AffiliateProfile  @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount          Decimal           @db.Decimal(10, 2)
  currency        String            @default("USD")
  status          String            @default("PENDING")
  payoutMethod    String
  accountDetails  Json?
  referenceId     String?
  processedAt     DateTime?
  notes           String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([affiliateId])
  @@index([status])
  @@map("payout_requests")
}

model CommissionLedgerEntry {
  id            String            @id @default(cuid())
  affiliateId   String
  affiliate     AffiliateProfile  @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  type          String
  amount        Decimal           @db.Decimal(10, 2)
  balanceAfter  Decimal           @db.Decimal(10, 2)
  reason        String
  referenceId   String?

  createdAt     DateTime          @default(now())

  @@index([affiliateId])
  @@index([createdAt])
  @@map("commission_ledger_entries")
}

// ==========================================
// PHASE 4 — JEWELLERY APPRAISAL
// ==========================================

model AppraisalRecord {
  id                String        @id @default(cuid())
  appraisalCode     String        @unique
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String?
  jewelryType       String
  metalType         String?
  gemstoneType      String?
  description       String?       @db.Text
  images            String[]      @default([])
  estimatedValue    Decimal?      @db.Decimal(10, 2)
  appraisedValue    Decimal?      @db.Decimal(10, 2)
  appraiserNotes    String?       @db.Text
  certificateNumber String?       @unique
  status            String        @default("SUBMITTED")
  appraisedAt       DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([appraisalCode])
  @@index([status])
  @@map("appraisal_records")
}

// ==========================================
// PHASE 5 — REVIEWS
// ==========================================

model ProductReview {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  comment            String       @db.Text
  isVerifiedPurchase Boolean      @default(false)
  isApproved         Boolean      @default(true)

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@map("product_reviews")
}

// ==========================================
// PHASE 6 — WISHLIST
// ==========================================

model WishlistItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

// ==========================================
// PHASE 7 — COUPONS / DISCOUNTS
// ==========================================

model DiscountCoupon {
  id                 String        @id @default(cuid())
  code               String        @unique
  description        String?
  discountType       String
  discountValue      Decimal       @db.Decimal(10, 2)
  minOrderAmount     Decimal?      @db.Decimal(10, 2)
  maxDiscountAmount  Decimal?      @db.Decimal(10, 2)
  startDate          DateTime      @default(now())
  endDate            DateTime?
  maxUses            Int?
  currentUses        Int           @default(0)
  maxUsesPerUser     Int           @default(1)
  isActive           Boolean       @default(true)

  couponUsages       CouponUsage[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("discount_coupons")
}

model CouponUsage {
  id              String          @id @default(cuid())
  couponId        String
  coupon          DiscountCoupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  discountApplied Decimal         @db.Decimal(10, 2)

  createdAt       DateTime        @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

// ==========================================
// PHASE 8 — NOTIFICATIONS
// ==========================================

model UserNotification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String    @db.Text
  type       String
  isRead     Boolean   @default(false)
  actionUrl  String?
  metadata   Json?

  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("user_notifications")
}

// ==========================================
// PHASE 9 — VIP / MEMBERSHIP
// ==========================================

model MembershipPlan {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  interval        String           @default("MONTHLY")
  discountPercent Decimal          @default(10) @db.Decimal(5, 2)
  freeShipping    Boolean          @default(true)
  perks           String[]         @default([])
  isActive        Boolean          @default(true)

  memberships     UserMembership[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("membership_plans")
}

model UserMembership {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  status      String          @default("ACTIVE")
  startDate   DateTime        @default(now())
  endDate     DateTime?
  autoRenew   Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@map("user_memberships")
}

// ==========================================
// PHASE 10 — CMS
// ==========================================

model CmsPage {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  content         String    @db.Text
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("cms_pages")
}

model CmsBanner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  position    String    @default("HERO")
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([position])
  @@index([isActive])
  @@map("cms_banners")
}

model CmsNavigationItem {
  id          String              @id @default(cuid())
  label       String
  url         String
  parentId    String?
  parent      CmsNavigationItem?  @relation("NavHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    CmsNavigationItem[] @relation("NavHierarchy")
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  location    String              @default("HEADER")

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([location])
  @@index([isActive])
  @@map("cms_navigation_items")
}

// ==========================================
// PHASE 11 — REPORTS / ANALYTICS
// ==========================================

model DailySalesSnapshot {
  id             String    @id @default(cuid())
  date           DateTime  @unique
  totalOrders    Int       @default(0)
  totalSales     Decimal   @default(0) @db.Decimal(12, 2)
  totalRefunds   Decimal   @default(0) @db.Decimal(12, 2)
  netSales       Decimal   @default(0) @db.Decimal(12, 2)
  totalShipping  Decimal   @default(0) @db.Decimal(10, 2)
  totalTax       Decimal   @default(0) @db.Decimal(10, 2)
  totalDiscounts Decimal   @default(0) @db.Decimal(10, 2)
  newCustomers   Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([date])
  @@map("daily_sales_snapshots")
}

